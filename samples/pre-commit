#!/bin/sh
# Sample pre-commit hook: fail the commit when findcrypto finds secrets.
#
# Install: cp samples/pre-commit .git/hooks/pre-commit
# Override the binary: FINDCRYPTO=/path/to/findcrypto git commit ...
# FINDBTC remains a compatibility fallback for existing hooks.
#
# Sweeps the whole worktree with the secrets profile. For large repos this is
# slow on every commit; run the same command manually before sharing changes,
# or narrow your normal hook and schedule a full local sweep separately.
set -u

FINDCRYPTO="${FINDCRYPTO:-${FINDBTC:-}}"
if [ -z "$FINDCRYPTO" ]; then
  if command -v findcrypto >/dev/null 2>&1; then
    FINDCRYPTO=findcrypto
  else
    FINDCRYPTO=findbtc
  fi
fi

TOP="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "pre-commit(findcrypto): not a git repo" >&2
  exit 1
}

OUT="$(mktemp)" || exit 1
# No `if` here: capture the status directly. (`if cmd; then...; fi`
# with no else exits 0 when cmd fails, which would swallow the gate.)
"$FINDCRYPTO" -walk "$TOP" -profile=secrets -fail-on-hit -json > "$OUT" 2>/dev/null
status=$?
if [ "$status" -eq 0 ]; then
  rm -f "$OUT"
  exit 0
fi
if [ "$status" -eq 3 ]; then
  echo "pre-commit(findcrypto): secrets found — not committing:" >&2
  cat "$OUT" >&2
  echo "Remove the secrets and retry; the findcrypto secrets-profile docs have the rotate/revoke checklist." >&2
else
  echo "pre-commit(findcrypto): scanner failed (exit $status); rerun it by hand to see why" >&2
fi
rm -f "$OUT"
exit "$status"
